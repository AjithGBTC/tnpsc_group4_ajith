APP_ENV=development
DATABASE_URL=postgresql+asyncpg://exam_admin:exam_admin@postgres:5432/exam_platform
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional additional origin matcher. Keep it anchored in production, e.g.
# CORS_ORIGIN_REGEX=^https://your-admin-app\.onrender\.com$
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS_PATH=
OTP_LOG_CODES=false
S3_BUCKET=
AWS_REGION=ap-south-1
